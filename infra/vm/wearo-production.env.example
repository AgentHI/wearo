# Copy these names into the VM's protected secret/environment configuration.
# Never commit the populated file. All API and worker processes must receive the same values.
WEARO_ENVIRONMENT=production
WEARO_DATABASE_URL=postgresql://doadmin:URL_ENCODED_PASSWORD@db-pgsql-blr1-13885-do-user-960149-0.f.db.ondigitalocean.com:25060/defaultdb?sslmode=require

# Production-safe values relevant to database-backed services.
WEARO_LOCAL_DOTENV_OVERRIDE=false
WEARO_SECURE_COOKIE=true
WEARO_TEST_AUTH_ENABLED=false
WEARO_LOCAL_EMBEDDED_WORKER=false

# AWS End User Messaging SMS. Keep test auth disabled when this is enabled.
WEARO_SMS_AWS_REGION=ap-south-1
WEARO_SMS_ORIGINATION_IDENTITY=
WEARO_SMS_CONFIGURATION_SET=
WEARO_SMS_ENTITY_ID=
WEARO_SMS_TEMPLATE_ID=
WEARO_SMS_MESSAGE_TEMPLATE=Your Wearo OTP is {code}. Do not share it with anyone.

# Supply the remaining required application, Cost Lab, storage, email, and provider secrets
# through the VM's secret manager or protected environment configuration.
# Razorpay API credentials and a separately generated webhook signing secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
