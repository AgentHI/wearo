# Local PostgreSQL (never commit the real password)
WEARO_LOCAL_DOTENV_OVERRIDE=true
WEARO_DATABASE_URL=postgresql://wearo:replace-me@127.0.0.1:55432/wearo_dev

# Generate with: openssl rand -base64 48
WEARO_AUTH_PEPPER=replace-with-at-least-32-random-bytes
WEARO_SECURE_COOKIE=false
WEARO_PRIVATE_STORAGE_ROOT=.wearo-storage
WEARO_CONSUMER_ORIGIN=http://localhost:5173

# Local testing only. Never enable fixed authentication in staging or production.
WEARO_TEST_AUTH_ENABLED=true
WEARO_TEST_OTP_CODE=9876
WEARO_DAILY_LIMIT_ENABLED=true
WEARO_RENDER_QUALITY_GATE_ENABLED=true
WEARO_LOCAL_EMBEDDED_WORKER=false

# Email OTP delivery. If WEARO_SMTP_HOST is empty, OTP requests fail closed with HTTP 503.
WEARO_SMTP_HOST=
WEARO_SMTP_PORT=587
WEARO_SMTP_USERNAME=
WEARO_SMTP_PASSWORD=
WEARO_SMTP_FROM=
WEARO_SMTP_TLS=true

# External render activation remains gated by docs/release/BETA_RELEASE_GATES.md.
# Select exactly one provider. OPENAI does not require a Google Vertex subscription.
WEARO_RENDER_PROVIDER=OPENAI
WEARO_OPENAI_API_KEY=
WEARO_OPENAI_MODEL=gpt-image-2.5-sunburst
WEARO_OPENAI_ANALYSIS_MODEL=gpt-6-luna
WEARO_OPENAI_ENABLED=false

# Optional alternative provider retained for later use.
WEARO_VERTEX_PROJECT_ID=
WEARO_VERTEX_REGION=asia-southeast1
WEARO_VERTEX_ENABLED=false

# Approved HTTPS service implementing the documented preflight and quality signal contract.
WEARO_ANALYSIS_ENDPOINT=
WEARO_ANALYSIS_TOKEN=
WEARO_WORKER_ID=
WEARO_PAYMENT_ORDER_ENDPOINT=
WEARO_PAYMENT_API_KEY=
WEARO_PAYMENT_WEBHOOK_SECRET=
WEARO_SMS_ENDPOINT=
WEARO_SMS_API_KEY=
WEARO_SMS_SENDER=
